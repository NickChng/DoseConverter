<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="ExampleEnum" final="restriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UNDEFINED" />
      <xs:enumeration value="option1" />
      <xs:enumeration value="option2" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ExampleUnitPresentation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Relative" />
      <xs:enumeration value="Absolute" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AlphaBetaValues">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PositiveDouble">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="DoseConverterConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="version">
          <xs:complexType>
            <xs:attribute name="number" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Defaults">
          <xs:complexType>
            <xs:attribute name="AlphaBetaRatio" type="PositiveDouble" use="required"/>
            <xs:attribute name="TempEdgeStructureName" type="xs:string" use="required"/>
            <xs:attribute name="TempStructureSetName" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Structures" >
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Structure" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Aliases">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Alias" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="StructureId" type="xs:string"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="StructureLabel" type="xs:string" use="required" />
                  <xs:attribute name="MaxEQD2" type="PositiveDouble" use="optional" />
                  <xs:attribute name="AlphaBetaRatio" type="AlphaBetaValues" use="required" />
                  <xs:attribute name="ForceEdgeConversion" type="xs:boolean" use="optional" default="true" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="RegistrationParameters" minOccurs="0">
          <xs:complexType>
            <!-- B-spline grid: number of control points along each image axis (e.g. "5 5 5") -->
            <xs:attribute name="BSplineGridNodes" type="xs:string" use="optional" default="5 5 5"/>
            <!-- B-spline polynomial order (3 = cubic) -->
            <xs:attribute name="BSplineOrder" type="xs:positiveInteger" use="optional" default="3"/>
            <!-- Fraction of voxels sampled per iteration (0–1) -->
            <xs:attribute name="MetricSamplingPercentage" type="PositiveDouble" use="optional" default="0.1"/>
            <!-- L-BFGS-B: gradient convergence tolerance -->
            <xs:attribute name="GradientConvergenceTolerance" type="PositiveDouble" use="optional" default="1e-5"/>
            <!-- L-BFGS-B: maximum iterations -->
            <xs:attribute name="MaxIterations" type="xs:positiveInteger" use="optional" default="100"/>
            <!-- L-BFGS-B: maximum corrections stored in memory -->
            <xs:attribute name="MaxCorrections" type="xs:positiveInteger" use="optional" default="5"/>
            <!-- L-BFGS-B: maximum function evaluations -->
            <xs:attribute name="MaxFunctionEvaluations" type="xs:positiveInteger" use="optional" default="1000"/>
            <!-- L-BFGS-B: cost-function convergence factor -->
            <xs:attribute name="CostFunctionConvergenceFactor" type="PositiveDouble" use="optional" default="1e7"/>
            <!-- Multi-resolution: downsample factors per level, space-separated (e.g. "4 2 1") -->
            <xs:attribute name="ShrinkFactorsPerLevel" type="xs:string" use="optional" default="4 2 1"/>
            <!-- Multi-resolution: Gaussian smoothing sigmas per level in mm, space-separated (e.g. "2.0 1.0 0.0") -->
            <xs:attribute name="SmoothingSigmasPerLevel" type="xs:string" use="optional" default="2.0 1.0 0.0"/>
            <!-- Per-level L-BFGS-B iteration caps, space-separated (one per level, e.g. "100 50 20"). Overrides MaxIterations. -->
            <xs:attribute name="MaxIterationsPerLevel" type="xs:string" use="optional" default="100 50 20"/>
            <!-- Margin in mm around the mask bounding box used to crop the fixed image for B-spline initialisation -->
            <xs:attribute name="MaskMarginMm" type="PositiveDouble" use="optional" default="20"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>