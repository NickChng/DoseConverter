<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="ExampleEnum" final="restriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="UNDEFINED" />
      <xs:enumeration value="option1" />
      <xs:enumeration value="option2" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ExampleUnitPresentation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Relative" />
      <xs:enumeration value="Absolute" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AlphaBetaValues">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="20"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="PositiveDouble">
    <xs:restriction base="xs:double">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="RegistrationAlgorithmType">
    <xs:restriction base="xs:string">
      <!-- Diffeomorphic demons (PDE/Thirion). Best with NO masks; masking is approximated by intensity-zeroing. -->
      <xs:enumeration value="Demons" />
      <!-- B-spline + Mattes MI via ImageRegistrationMethod. Supports TRUE metric masks (fixed/moving) so out-of-body anatomy (e.g. bolus) is excluded from the optimisation itself. -->
      <xs:enumeration value="BSpline" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="DoseConverterConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="version">
          <xs:complexType>
            <xs:attribute name="number" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Defaults">
          <xs:complexType>
            <xs:attribute name="AlphaBetaRatio" type="PositiveDouble" use="required"/>
            <xs:attribute name="TempEdgeStructureName" type="xs:string" use="required"/>
            <xs:attribute name="TempStructureSetName" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Structures" >
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Structure" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Aliases">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="Alias" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:attribute name="StructureId" type="xs:string"/>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                  <xs:attribute name="StructureLabel" type="xs:string" use="required" />
                  <xs:attribute name="MaxEQD2" type="PositiveDouble" use="optional" />
                  <xs:attribute name="AlphaBetaRatio" type="AlphaBetaValues" use="required" />
                  <xs:attribute name="ForceEdgeConversion" type="xs:boolean" use="optional" default="true" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="RegistrationParameters" minOccurs="0">
          <xs:complexType>
            <!-- Which registration algorithm to use by default. The UI can override this per-run. -->
            <xs:attribute name="RegistrationAlgorithm" type="RegistrationAlgorithmType" use="optional" default="Demons"/>
            <!-- B-spline grid: number of control points along each image axis.
                 For a typical H&N CT (~350×300×250 mm) "12 12 8" gives ~30 mm spacing.
                 Coarser grids (e.g. "5 5 5") cannot capture soft-tissue shifts. -->
            <xs:attribute name="BSplineGridNodes" type="xs:string" use="optional" default="12 12 8"/>
            <!-- B-spline control-point spacing (mm) over the BODY region. The grid mesh is derived
                 from this spacing and the auto-detected (or masked) body bounding box, so density is
                 anatomically meaningful and independent of CT FOV / patient size. This supersedes
                 BSplineGridNodes, which is now only a fallback used if body detection fails. -->
            <xs:attribute name="BSplineControlPointSpacing" type="PositiveDouble" use="optional" default="20"/>
            <!-- B-spline polynomial order (3 = cubic) -->
            <xs:attribute name="BSplineOrder" type="xs:positiveInteger" use="optional" default="3"/>
            <!-- Fraction of voxels sampled per iteration (0–1).
                 With metric masks the effective image volume is already small; REGULAR sampling
                 gives L-BFGS-B consistent per-evaluation gradients and converges faster than RANDOM.
                 Set to 1.0 to use every voxel inside the mask (most consistent, recommended). -->
            <xs:attribute name="MetricSamplingPercentage" type="PositiveDouble" use="optional" default="1.0"/>
            <!-- L-BFGS-B: gradient convergence tolerance -->
            <xs:attribute name="GradientConvergenceTolerance" type="PositiveDouble" use="optional" default="1e-5"/>
            <!-- L-BFGS-B: per-level max iterations fallback (overridden by MaxIterationsPerLevel) -->
            <xs:attribute name="MaxIterations" type="xs:positiveInteger" use="optional" default="100"/>
            <!-- L-BFGS-B: number of corrections stored in memory (5–20; higher = better curvature estimate) -->
            <xs:attribute name="MaxCorrections" type="xs:positiveInteger" use="optional" default="5"/>
            <!-- L-BFGS-B: max function evaluations per level -->
            <xs:attribute name="MaxFunctionEvaluations" type="xs:positiveInteger" use="optional" default="1000"/>
            <!-- L-BFGS-B: cost-function convergence factor. Set to 0 to disable (rely on iteration count
                 and gradient tolerance). With stochastic sampling, 0 prevents premature early exit. -->
            <xs:attribute name="CostFunctionConvergenceFactor" type="PositiveDouble" use="optional" default="0"/>
            <!-- Multi-resolution: downsample factors per level, space-separated (e.g. "4 2 1") -->
            <xs:attribute name="ShrinkFactorsPerLevel" type="xs:string" use="optional" default="4 2 1"/>
            <!-- Multi-resolution: Gaussian smoothing sigmas per level in mm, space-separated (e.g. "2.0 1.0 0.0") -->
            <xs:attribute name="SmoothingSigmasPerLevel" type="xs:string" use="optional" default="2.0 1.0 0.0"/>
            <!-- Per-level iteration caps, space-separated (one per level, e.g. "50 30 20"). Overrides MaxIterations.
                 L-BFGS-B takes large steps so fewer iterations are needed vs. gradient descent. -->
            <xs:attribute name="MaxIterationsPerLevel" type="xs:string" use="optional" default="50 30 20"/>
            <!-- Margin in mm around the mask bounding box used to crop the fixed image for B-spline initialisation -->
            <xs:attribute name="MaskMarginMm" type="PositiveDouble" use="optional" default="20"/>
            <!-- Diffeomorphic demons: space-separated Gaussian std-devs (mm) for displacement-field smoothing; one value is broadcast to all levels -->
            <xs:attribute name="DemonsStandardDeviations" type="xs:string" use="optional" default="1.0"/>
            <!-- Diffeomorphic demons: maximum update step length (mm) -->
            <xs:attribute name="DemonsMaxStepLength" type="PositiveDouble" use="optional" default="2.0"/>
            <!-- Default output directory for deformed DICOM export.  If omitted the script assembly directory is used. -->
            <xs:attribute name="DicomExportDirectory" type="xs:string" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="SitePresets" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="SitePreset" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <!-- Display name shown in the combo box (e.g. "Brain", "Thorax / Lung") -->
                  <xs:attribute name="Name" type="xs:string" use="required"/>
                  <!-- Gaussian std-dev for displacement-field smoothing (mm) -->
                  <xs:attribute name="StdDev" type="PositiveDouble" use="required"/>
                  <!-- Space-separated per-level iteration caps (e.g. "50 50 20") -->
                  <xs:attribute name="Iterations" type="xs:string" use="required"/>
                  <!-- Maximum demons update step length (mm) -->
                  <xs:attribute name="MaxStepLength" type="PositiveDouble" use="required"/>
                  <!-- B-spline control-point spacing (mm) for this site. Optional; 0 / omitted = use
                       the global BSplineControlPointSpacing default. Finer (smaller) = more local
                       deformation but higher DOF / runtime; ~20 mm is a reasonable H&N starting point,
                       lower toward 15 mm once runtime is acceptable to better capture neck flexion /
                       nodal tissue loss. -->
                  <xs:attribute name="BSplineSpacing" type="PositiveDouble" use="optional" default="20"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>