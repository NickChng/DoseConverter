<UserControl x:Class="DoseConverter.Views.DeformableRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DoseConverter"
             xmlns:ViewModels="clr-namespace:DoseConverter.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ViewModels:DeformableRegistrationViewModel, IsDesignTimeCreatable=True}"
             Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="XAMLDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="{x:Type Button}"/>
            <Style TargetType="{x:Type Label}"/>
            <Style TargetType="{x:Type Border}"/>
            <Style TargetType="{x:Type CheckBox}"/>
            <Style TargetType="{x:Type TextBox}"/>
            <Style TargetType="{x:Type TextBlock}"/>
            <Style TargetType="{x:Type GroupBox}"/>
            <local:VisibilityConverter x:Key="VisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="DimGray" FontStyle="Italic"
                       Text="Deformable image registration (DIR) warps the source plan's dose onto the target image's CT geometry using diffeomorphic demons (via SimpleITK). It is recommended to start with a rigid registration for improved alignment. The output is a new Eclipse verification plan containing the deformed dose. Only unimodal CT-to-CT registration is supported. Runtime is typically 5–10 minutes depending on image size and DIR parameters."/>
            <Border Grid.Row="1" HorizontalAlignment="Stretch" Height="1" CornerRadius="4" Background="Black" Margin="0,8,0,8"/>
        </Grid>

        <!-- Plan selection + structure masks -->
        <Grid Grid.Row="1" Margin="0,5,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Source plan -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Source (moving) plan" VerticalAlignment="Bottom" FontWeight="Bold"/>
                <ComboBox Grid.Row="1"
                          Style="{StaticResource ComboBoxStyle}"
                          Template="{StaticResource ComboBoxControlTemplate}"
                          Height="30"
                          ItemsSource="{Binding AllPlanOptions}"
                          SelectedItem="{Binding SelectedSourcePlan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayString}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Arrow -->
            <TextBlock Grid.Row="0" Grid.Column="1" Text="→" FontSize="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Foreground="CornflowerBlue"/>

            <!-- Target image -->
            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Target (fixed) image" VerticalAlignment="Bottom" FontWeight="Bold"/>
                <ComboBox Grid.Row="1"
                          Style="{StaticResource ComboBoxStyle}"
                          Template="{StaticResource ComboBoxControlTemplate}"
                          Height="30"
                          ItemsSource="{Binding AllTargetOptions}"
                          SelectedItem="{Binding SelectedTargetSS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayString}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Separator -->
            <Border Grid.Row="0" Grid.Column="3" Width="1" Background="LightGray" VerticalAlignment="Stretch" Margin="5,5,5,5"/>

            <!-- Output plan name -->
            <Grid Grid.Row="0" Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Output plan name (max 13 chars)" VerticalAlignment="Bottom" FontWeight="Bold"/>
                <TextBox Grid.Row="1"
                         Height="30"
                         Padding="5,0,5,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding DeformedPlanName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="13"
                         Background="{Binding DeformedPlanNameBackground}"
                         ToolTip="{Binding DeformedPlanNameError}"/>
                <TextBlock Grid.Row="2" Text="Physical dose — review in Eclipse before EQD2 conversion."
                           Foreground="DimGray" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"/>

                <!-- DICOM export directory + export button (visible after a successful DIR run) -->
                <StackPanel Grid.Row="3" Orientation="Vertical"
                            Visibility="{Binding ExportButtonVisibility}"
                            Margin="0,10,0,0">
                    <Label Content="DICOM export directory" FontWeight="Bold" Padding="0,0,0,2"/>
                    <!-- Editable path row: text box + browse button side-by-side -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Height="28"
                                 Padding="4,0,4,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ExportDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Type or paste the output directory path (UNC paths such as \\server\share are supported). Click … to browse."/>
                        <Button Grid.Column="2"
                                Content="…"
                                Width="28"
                                Height="28"
                                Command="{Binding BrowseExportDirectoryCommand}"
                                ToolTip="Browse for output folder"/>
                    </Grid>
                    <TextBlock Text="Tip: UNC paths (\\server\share\folder) can be pasted directly."
                               Foreground="DimGray" FontSize="10" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Button Content="Export deformed DICOM…"
                            Height="30"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ExportDicomCommand}"
                            ToolTip="Export the deformed CT series and warped structure set to the directory above as DICOM."/>
                </StackPanel>
            </Grid>

            <!-- Structure mask row -->
            <Grid Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Source mask structure" VerticalAlignment="Bottom" FontWeight="Bold"/>
                <ComboBox Grid.Row="1"
                          Style="{StaticResource ComboBoxStyle}"
                          Template="{StaticResource ComboBoxControlTemplate}"
                          Height="30"
                          ItemsSource="{Binding SourceStructureOptions}"
                          SelectedItem="{Binding SelectedSourceStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="Constrains registration metric to this structure's voxels."
                           Foreground="DimGray" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </Grid>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="→" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="CornflowerBlue" Opacity="0.4"/>

            <Grid Grid.Row="2" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="Target mask structure" VerticalAlignment="Bottom" FontWeight="Bold"/>
                <ComboBox Grid.Row="1"
                          Style="{StaticResource ComboBoxStyle}"
                          Template="{StaticResource ComboBoxControlTemplate}"
                          Height="30"
                          ItemsSource="{Binding TargetStructureOptions}"
                          SelectedItem="{Binding SelectedTargetStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="Can differ from source mask — each is rasterized on its own CT."
                           Foreground="DimGray" FontSize="10" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </Grid>

            <Border Grid.Row="2" Grid.Column="3" Width="1" Background="LightGray" VerticalAlignment="Stretch" Margin="5,5,5,5"/>

            <!-- Rigid initial registration row -->
            <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="470"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Initial rigid registration:" VerticalAlignment="Center" FontWeight="Bold"
                       ToolTip="Select an Eclipse rigid registration to use as the starting alignment before B-spline fitting. Populated automatically after source plan and target image are selected. Only registrations linking the two CT frames of reference are shown."/>
                <ComboBox Grid.Column="2"
                          Style="{StaticResource ComboBoxStyle}"
                          Template="{StaticResource ComboBoxControlTemplate}"
                          Height="30"
                          ItemsSource="{Binding RigidRegistrationOptions}"
                          SelectedItem="{Binding SelectedRigidRegistration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayString}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="Only registrations linking the source and target CT frames of reference are shown."
                           Foreground="DimGray" FontSize="10" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Grid>

		<!-- Registration parameters panel -->
		<GroupBox Grid.Row="2" Header="Registration parameters (Diffeomorphic Demons)" Margin="0,0,0,10" VerticalAlignment="Stretch">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Margin="8,8,8,8">

					<!-- Site preset row -->
					<Grid Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="180"/>
							<ColumnDefinition Width="220"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Label Grid.Column="0" Content="Anatomical site:" VerticalAlignment="Center" FontWeight="Bold"
							   ToolTip="Select the treatment site to load clinically tuned defaults. Adjusting any parameter afterwards switches to (custom)."/>
						<ComboBox Grid.Column="1"
								  Style="{StaticResource ComboBoxStyle}"
								  Template="{StaticResource ComboBoxControlTemplate}"
								  Height="28"
								  ItemsSource="{Binding SitePresets}"
								  SelectedItem="{Binding SelectedSite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								  DisplayMemberPath="Name"
								  VerticalContentAlignment="Center"/>
						<TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
								   Foreground="DimGray" FontSize="10" FontStyle="Italic" Margin="8,0,0,0"
								   Text="Presets apply site-optimised smoothing, iterations, and step length. Select (custom) to edit freely."/>
					</Grid>

					<Border Height="1" Background="LightGray" Margin="0,0,0,8"/>

					<!-- Smoothing slider row -->
					<Grid Margin="0,0,0,8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="180"/>
							<ColumnDefinition Width="60"/>
							<ColumnDefinition Width="160"/>
							<ColumnDefinition Width="60"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="Field regularisation:" VerticalAlignment="Center" FontWeight="Bold"
								   ToolTip="Controls how smoothly the deformation varies across the image. Higher (smoother) forces neighbouring tissue to move together, producing a gradual, physically realistic warp -- safer, but it may under-correct genuine local motion. Lower (more flexible) lets the deformation bend sharply to match fine local detail -- better for large or localised motion (e.g. bladder filling), but more prone to unrealistic folding and to chasing image noise. If unsure, start higher and reduce only if the registration is clearly under-fitting."/>
						<TextBlock Grid.Column="1" Text="Flexible" VerticalAlignment="Center" HorizontalAlignment="Right"
								   Foreground="DimGray" FontSize="10" Margin="0,0,4,0"/>
						<Slider Grid.Column="2"
								Minimum="1.0" Maximum="3.0" TickFrequency="0.1"
								IsSnapToTickEnabled="False"
								Value="{Binding SmoothingSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
								VerticalAlignment="Center"
								ToolTip="{Binding SmoothingLabel}"/>
						<TextBlock Grid.Column="3" Text="Smooth" VerticalAlignment="Center"
								   Foreground="DimGray" FontSize="10" Margin="4,0,0,0"/>
						<TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0"
								   Text="{Binding SmoothingLabel}" FontSize="11" Foreground="CornflowerBlue" FontWeight="Bold"/>
					</Grid>

					<!-- Parameter grid: editable + fixed columns -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="180"/>
							<ColumnDefinition Width="120"/>
							<ColumnDefinition Width="8"/>
							<ColumnDefinition Width="180"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="6"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="6"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="6"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="6"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- Column headers -->
						<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Editable" FontWeight="Bold" Foreground="CornflowerBlue"/>
						<TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Text="Fixed (edit in DoseConverterConfig.xml)" FontWeight="Bold" Foreground="DimGray"/>

						<!-- Max iters per level -->
						<TextBlock Grid.Row="2" Grid.Column="0" Text="Max iters per level:" VerticalAlignment="Center"
								   ToolTip="Space-separated iteration caps per resolution level (coarsest to finest), e.g. '75 50 25'. More iterations improve accuracy at the cost of runtime."/>
						<TextBox   Grid.Row="2" Grid.Column="1" Height="24" Padding="4,0,4,0" VerticalContentAlignment="Center"
								   Text="{Binding RegMaxIterationsPerLevel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
								   ToolTip="Space-separated integers, one per pyramid level (e.g. '75 50 25')"/>

						<!-- Algorithm (static) -->
						<TextBlock Grid.Row="2" Grid.Column="3" Text="Algorithm:" VerticalAlignment="Center" Foreground="DimGray"/>
						<TextBlock Grid.Row="2" Grid.Column="4" Text="Diffeomorphic Demons (CT-CT)" VerticalAlignment="Center" Foreground="DimGray"/>

						<!-- Max step length -->
						<TextBlock Grid.Row="4" Grid.Column="0" Text="Max update step (mm):" VerticalAlignment="Center"
								   ToolTip="Maximum displacement per iteration update step in mm. Larger values allow faster convergence for big deformations but increase folding risk. Typically 1.0 (brain) to 3.0 (lung/pelvis)."/>
						<TextBox   Grid.Row="4" Grid.Column="1" Height="24" Padding="4,0,4,0" VerticalContentAlignment="Center"
								   Text="{Binding RegMaxStepLength, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
								   ToolTip="e.g. 1.0 (brain), 2.5 (abdomen), 3.0 (lung/pelvis)"/>

						<!-- Pyramid levels (static) -->
						<TextBlock Grid.Row="4" Grid.Column="3" Text="Pyramid (shrink factors):" VerticalAlignment="Center" Foreground="DimGray"
								   ToolTip="Set ShrinkFactorsPerLevel in DoseConverterConfig.xml to change (default: 4 2 1)."/>
						<TextBlock Grid.Row="4" Grid.Column="4" Text="4x to 2x to 1x (config)" VerticalAlignment="Center" Foreground="DimGray"/>

						<!-- Intensity pre-processing (static) -->
						<TextBlock Grid.Row="6" Grid.Column="3" Text="Intensity pre-processing:" VerticalAlignment="Center" Foreground="DimGray"/>
						<TextBlock Grid.Row="6" Grid.Column="4" Text="Histogram match + rescale 0-255" VerticalAlignment="Center" Foreground="DimGray"/>

						<!-- Mask crop margin -->
						<TextBlock Grid.Row="8" Grid.Column="0" Text="Mask crop margin (mm):" VerticalAlignment="Center"
								   ToolTip="When a mask is selected, the fixed CT is cropped to the mask bounding box plus this margin. Ignored when no mask is set."/>
						<TextBox   Grid.Row="8" Grid.Column="1" Height="24" Padding="4,0,4,0" VerticalContentAlignment="Center"
								   Text="{Binding RegMaskMarginMm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
								   ToolTip="Positive number in mm (e.g. 20)"/>
						<TextBlock Grid.Row="8" Grid.Column="3" Text="Only used when a mask is set." VerticalAlignment="Center" Foreground="DimGray" FontStyle="Italic"/>
					</Grid>
				</StackPanel>
			</ScrollViewer>
		</GroupBox>

        <!-- Bottom bar: status + run button -->
        <Grid Grid.Row="3" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status area -->
            <GroupBox Grid.Column="0" Header="Status" VerticalContentAlignment="Center">
                <Grid VerticalAlignment="Center" Margin="0,0,0,0">
                    <ProgressBar Height="25" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Template="{StaticResource ProgressBarNC}" IsIndeterminate="True"
                                 Visibility="{Binding Working, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource VisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                                   Text="{Binding StatusMessage, FallbackValue=StatusMessage, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="10,3,10,3"/>
                        <Grid Visibility="{Binding SuccessVisibility, UpdateSourceTrigger=PropertyChanged}">
                            <Ellipse Height="20" Width="20" Fill="PaleGreen"/>
                            <Image Source="../Resources/check_trans_light.png" Height="15" Width="15"/>
                        </Grid>
                        <Grid Visibility="{Binding ErrorVisibility, UpdateSourceTrigger=PropertyChanged}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Name="ErrorDetailsButton"
                                    Command="{Binding ErrorDetailsButtonCommand}"
                                    Style="{StaticResource ButtonStyle_Medium}">
                                <Grid>
                                    <Ellipse Height="18" Width="18" Fill="Tomato"/>
                                    <Image Source="../Resources/exclamation_light.png" Height="15" Width="15" RenderOptions.BitmapScalingMode="Fant"/>
                                </Grid>
                            </Button>
                            <Popup PlacementTarget="{Binding ElementName=ErrorDetailsButton}" Placement="Top"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{Binding IsErrorDetailsOpen, UpdateSourceTrigger=PropertyChanged}">
                                <Border Background="White" BorderBrush="CornflowerBlue" BorderThickness="1" Padding="8" MaxWidth="400">
                                    <TextBlock TextWrapping="Wrap" Text="{Binding ErrorDetails, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Run button -->
            <Button Grid.Column="1" Margin="10,7,0,0" Height="30" Width="160"
                    Command="{Binding RunDIRCommand}"
                    Background="Transparent" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center" BorderThickness="0"
                    Visibility="{Binding RunButtonVisibility, UpdateSourceTrigger=PropertyChanged}">
                <Border Background="CornflowerBlue" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        CornerRadius="4" Padding="2,2,2,2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="2" Direction="225" Color="Black" Opacity="0.4"/>
                    </Border.Effect>
                    <TextBlock Text="Run DIR" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="White" Margin="5,0,5,0">
                        <TextBlock.Style>
                            <Style>
                                <Style.Triggers>
                                    <Trigger Property="TextBlock.IsMouseOver" Value="True">
                                        <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Button>
        </Grid>
    </Grid>
</UserControl>
