<?xml version="1.0" encoding="utf-8"?>
<DoseConverterConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"  xsi:noNamespaceSchemaLocation="\\spvaimapcn\data$\Apps\DoseConverter\Schemas\DoseConverterConfig.xsd">
  <version number="0.1"/>
  <Defaults AlphaBetaRatio="3" TempEdgeStructureName ="Temp_AutoEdge" TempStructureSetName="TEMP_DoseConv"/>
  <Structures>
    <Structure AlphaBetaRatio="3" StructureLabel="External" ForceEdgeConversion="false">
      <Aliases>
        <Alias StructureId="BODY"/>
      </Aliases>
    </Structure>
    <Structure AlphaBetaRatio="2" StructureLabel="Brainstem" MaxEQD2="50">
      <Aliases>
        <Alias StructureId="Brainstem"/>
        <!--Not case sensitive and underscores are ignored when matching-->
      </Aliases>
    </Structure>
    <Structure AlphaBetaRatio="2" StructureLabel="Segment of spinal cord" MaxEQD2="50">
      <Aliases>
        <Alias StructureId="SpinalCord"/>
        <Alias StructureId="SpinalCord_PRV"/>
        <!--Not case sensitive and underscores are ignored when matching-->
      </Aliases>
    </Structure>
    <Structure AlphaBetaRatio="2" StructureLabel="Spinal Canal">
      <Aliases>
        <Alias StructureId="SpinalCanal"/>
        <Alias StructureId="SpinalCanalPRV"/>
        <!--Not case sensitive and underscores are ignored when matching-->
      </Aliases>
    </Structure>
    <Structure AlphaBetaRatio="2" StructureLabel="Segment of spinal cord">
      <Aliases>
        <Alias StructureId="SpinalCord_PRV"/>
        <!--Not case sensitive and underscores are ignored when matching-->
      </Aliases>
    </Structure>
    <Structure AlphaBetaRatio="2" StructureLabel="Bronchial Tree">
      <Aliases>
        <Alias StructureId="ProxBronchTree"/>
        <!--Not case sensitive and underscores are ignored when matching-->
      </Aliases>
    </Structure>
    <Structure AlphaBetaRatio="2" StructureLabel="">
      <Aliases>
        <Alias StructureId="ProxTrachea"/>
        <!--Not case sensitive and underscores are ignored when matching-->
      </Aliases>
    </Structure>
  </Structures>
  <RegistrationParameters
    RegistrationAlgorithm="Demons"
    BSplineGridNodes="10 10 8"
    BSplineControlPointSpacing="20"
    BSplineOrder="3"
    MetricSamplingPercentage="0.1"
    GradientConvergenceTolerance="1e-5"
    MaxIterations="100"
    MaxIterationsPerLevel="100 50 20"
    MaxCorrections="5"
    MaxFunctionEvaluations="1000"
    CostFunctionConvergenceFactor="1e7"
    ShrinkFactorsPerLevel="4 2 1"
    SmoothingSigmasPerLevel="2.0 1.0 0.0"
    MaskMarginMm="20"
    DemonsStandardDeviations="1.0"
    DemonsMaxStepLength="2.0"
    DemonsSurfaceStage="true"/>
  <SitePresets>
    <!-- Each SitePreset appears in the anatomical site combo box.
         Add, remove, or edit entries here to customise available presets.
         Attributes:
           Name           – label shown in the UI
           StdDev         – Gaussian std-dev for displacement-field smoothing (mm)
           Iterations     – space-separated per-level iteration caps (coarse → fine)
           MaxStepLength  – maximum demons update step length (mm)
           BSplineSpacing – B-spline control-point spacing (mm) over the body region; smaller =
                            finer local deformation (B-spline algorithm only) -->
    <SitePreset Name="Brain"            StdDev="2.5" Iterations="50 50 20" MaxStepLength="1.0" BSplineSpacing="20"/>
    <SitePreset Name="Head &amp; Neck"  StdDev="2.0" Iterations="50 50 20" MaxStepLength="1.5" BSplineSpacing="20"/>
    <SitePreset Name="Thorax / Lung"    StdDev="1.0" Iterations="75 75 20" MaxStepLength="3.0" BSplineSpacing="20"/>
    <SitePreset Name="Abdomen"          StdDev="1.5" Iterations="75 50 20" MaxStepLength="2.5" BSplineSpacing="20"/>
    <SitePreset Name="Pelvis / Bladder" StdDev="1.5" Iterations="75 50 20" MaxStepLength="3.0" BSplineSpacing="20"/>
  </SitePresets>
</DoseConverterConfig>
